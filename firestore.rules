rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Verifica se o usuário está autenticado com e-mail confirmado
    function isAuthenticated() {
      return request.auth != null 
        && request.auth.token.email != null;
    }

    // Retorna o e-mail do usuário logado em minúsculas
    function userEmail() {
      return request.auth.token.email.lower();
    }

    // 2. Administrador Inicial Fixo da MT Solar
    function isInitialAdmin() {
      return isAuthenticated() 
        && userEmail() == 'mtsolar.energia@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // 3. Verifica se o e-mail existe no cadastro de usuários autorizados
    function isUsuarioAutorizado() {
      return isAuthenticated() && (
        isInitialAdmin() ||
        exists(/databases/$(database)/documents/usuarios_autorizados/$(userEmail()))
      );
    }

    // Obtém o documento de autorização do usuário
    function getUsuarioData() {
      return get(/databases/$(database)/documents/usuarios_autorizados/$(userEmail())).data;
    }

    // 4. Verifica se o usuário possui o papel de Administrador
    function isAdmin() {
      return isInitialAdmin() || (
        isUsuarioAutorizado() &&
        getUsuarioData().papel == 'administrador'
      );
    }

    // Coleção: usuarios_autorizados
    match /usuarios_autorizados/{userDoc} {
      // Cada usuário autenticado pode ler (get) exclusivamente seu próprio documento de autorização
      allow get: if isAuthenticated() && (userDoc == userEmail() || isInitialAdmin() || isAdmin());
      // Listagem completa (list), criação, atualização e exclusão somente para Administradores
      allow list, create, update, delete: if isAuthenticated() && (isInitialAdmin() || isAdmin());
    }

    // Coleções Operacionais Corporativas MT Solar
    match /contas_bancarias/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    match /categorias/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    match /contatos/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    match /projetos/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    match /lancamentos/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    match /funcionarios/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    match /lancamentos_folha/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    match /configuracoes/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    match /historico_auditoria/{doc} {
      allow read: if isUsuarioAutorizado();
      allow write: if isAdmin();
    }

    // Nega por padrão qualquer outra coleção não declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
