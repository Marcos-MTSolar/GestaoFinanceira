rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica se o usuário está autenticado com conta do Google / Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Retorna o e-mail do usuário em minúsculas
    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Verifica se o usuário é o Administrador Inicial Fixo da MT Solar
    function isInitialAdmin() {
      return isAuthenticated() && userEmail() == 'mtsolar.energia@gmail.com';
    }

    // Verifica se o e-mail do usuário existe na coleção usuarios_autorizados
    function isUsuarioAutorizado() {
      return isAuthenticated() && (
        isInitialAdmin() ||
        exists(/databases/$(database)/documents/usuarios_autorizados/$(userEmail())) ||
        exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid))
      );
    }

    // Obtém o documento do usuário autorizado no Firestore
    function getUsuarioData() {
      return get(/databases/$(database)/documents/usuarios_autorizados/$(userEmail())).data;
    }

    // Verifica se o usuário possui o papel de Administrador
    function isAdmin() {
      return isInitialAdmin() || (
        isUsuarioAutorizado() && 
        getUsuarioData().papel == 'administrador'
      );
    }

    // Regras para a Coleção de Usuários Autorizados
    match /usuarios_autorizados/{document} {
      // Leitura: Permitida para qualquer usuário autenticado verificar status de acesso
      allow read: if isAuthenticated();
      
      // Criação e Atualização: Apenas o Administrador Inicial Fixo (mtsolar.energia@gmail.com) ou Administradores existentes
      allow create, update: if isAuthenticated() && (isInitialAdmin() || isAdmin());
      
      // Exclusão: Apenas Administradores
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Regra Geral para Todas as Outras Coleções (contas, lançamentos, projetos, etc.)
    match /{document=**} {
      // Leitura: Permitida para qualquer usuário devidamente autorizado (inclui Visualizadores)
      allow read: if isAuthenticated() && isUsuarioAutorizado();

      // Escrita (Criar, Atualizar, Deletar): Exige autenticação e perfil de Administrador
      allow write: if isAuthenticated() && isUsuarioAutorizado() && isAdmin();
    }
  }
}
